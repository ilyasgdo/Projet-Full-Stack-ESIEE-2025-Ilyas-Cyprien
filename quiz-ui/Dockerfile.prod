# Version production avec API URL configurée pour /api
FROM node:lts-alpine as build

# Installation du framework Vue
RUN npm install -g @vue/cli

# Création et positionnement du répertoire par défaut dans le container
WORKDIR /app

# Copie des fichiers référençant les dépendances de la machine hôte vers le container
COPY package*.json ./

# Installation des dépendances
RUN npm install

# Copie du reste du code source
COPY . .

# Configuration pour production - API accessible via /api
ENV VITE_API_URL=/api

# Construction du bundle de l'application
RUN npm run build

# Serveur Nginx pour servir l'application
FROM nginx
COPY --from=build /app/dist /usr/share/nginx/html

# Configuration Nginx pour production avec proxy vers l'API
# Utilise host.docker.internal pour accéder au backend sur le port 5000
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://host.docker.internal:5000/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
        proxy_http_version 1.1; \
        proxy_set_header Connection ""; \
        proxy_buffering off; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
